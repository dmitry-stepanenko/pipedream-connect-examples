{
  "name": "workflows-api",
  "main": "src/index.ts",
  "account_id": "",
  "route": "",
  "workers_dev": true,
  "compatibility_date": "2026-02-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PIPEDREAM_PROJECT_ENVIRONMENT": "development",
    "MCP_SERVER": "https://remote.mcp.pipedream.net",
    "WORKER_BASE_URL": "https://workflows-api.dmitry-stepanenko.workers.dev",
    "ALLOWED_CORS_ORIGINS": "workflows-poc.pages.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "workflows-db",
      "database_id": "1a5ea8f0-f991-4887-ac38-eb642f588a12",
    },
  ],
  "secrets": {
    "required": [
      "PIPEDREAM_CLIENT_ID",
      "PIPEDREAM_CLIENT_SECRET",
      "PIPEDREAM_PROJECT_ID",
      "AZURE_OPENAI_ENDPOINT",
      "AZURE_OPENAI_API_KEY",
      "OPENAI_API_KEY",
    ]
  },
}
