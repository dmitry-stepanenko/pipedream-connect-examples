{
  "name": "connect-angular",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/connect-angular/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/connect-angular/jest.config.cts",
        "tsConfig": "libs/connect-angular/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "main": "libs/connect-angular/src/index.ts",
        "outputPath": "dist/libs/connect-angular",
        "outputFileName": "main.js",
        "tsConfig": "libs/connect-angular/tsconfig.lib.json",
        "format": ["cjs"],
        "assets": [
          {
            "glob": "libs/connect-angular/README.md",
            "input": ".",
            "output": "."
          }
        ]
      },
      "configurations": {
        "development": {
          "minify": false
        },
        "production": {
          "minify": true
        }
      }
    }
  }
}
